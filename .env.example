# Copy to .env locally. Never commit .env. Blank credentials are intentional.
# GitHub: credentials are Secrets; other settings should be Variables.
GEMINI_API_KEY=
# Stable Flash-class model with structured output and a listed text free tier.
# Use a free-tier project WITHOUT billing; fail rather than switch to paid services.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4096
PEXELS_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Each run randomly selects one of these categories; recent story history prevents repeats.
SHORTS_TOPIC="Randomly select: Dark Psychology / Scary Stories or Bite-Sized History / Mysteries"
SHORTS_STYLE="Cinematic, dark, curiosity-driven; open with a sudden shocking anomaly (0-2s); short staccato sentences (max 10 words); no intro filler; ending seamlessly bridges back to the opening hook"
TARGET_DURATION_SECONDS=45
MIN_DURATION_SECONDS=40
MAX_DURATION_SECONDS=50

TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+12%
TTS_PITCH=-1Hz
TTS_VOLUME=+0%
TTS_TIMEOUT_SECONDS=180

# Safety defaults: changing privacy does not override DRY_RUN.
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=27
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true
DRY_RUN=true
# Explicit opt-in only; dry runs do not consume production topics by default.
DRY_RUN_UPDATE_HISTORY=false
PUBLICATION_CHANNEL=configured-youtube-channel
PUBLICATION_SLOT=manual
YOUTUBE_VERIFY_TIMEOUT_SECONDS=120

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_ASSET_BYTES=80000000
MIN_ASSET_BYTES=1024
PEXELS_RESULTS_PER_SEARCH=5
STOCK_MAX_SEARCHES_PER_SECTION=4
STOCK_MAX_DOWNLOADS_PER_SECTION=3
VISUAL_BACKEND=sketch
SKETCH_STYLE_PROMPT="Dark historical pencil sketch, vintage charcoal illustration, dramatic chiaroscuro lighting, detailed line art, atmospheric, 9:16 vertical composition"

# Executable names or absolute paths, never shell command strings.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=1200
FFPROBE_TIMEOUT_SECONDS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=21
VIDEO_PRESET=veryfast
FFMPEG_THREADS=2
AUDIO_BITRATE_KBPS=192

# ASS colors are &HAABBGGRR. Sizes and margins are 1080x1920 canvas pixels.
CAPTION_FONT=DejaVu Sans
CAPTION_FONT_SIZE=82
CAPTION_WORDS_PER_UNIT=2
CAPTION_MAX_CHARS_PER_LINE=24
CAPTION_MARGIN_X=100
CAPTION_MARGIN_BOTTOM=380
CAPTION_OUTLINE=6
CAPTION_PRIMARY_COLOR=&H00FFFFFF
CAPTION_HIGHLIGHT_COLOR=&H0000D7FF

# Paths must stay inside project root and writable directories must not overlap.
OUTPUT_DIR=output
WORK_DIR=work
STATE_DIR=state
FALLBACK_DIR=assets/fallback
LOG_LEVEL=INFO

# Local ledger is committed by the scheduled workflow after successful runs.
HISTORY_BACKEND=local
HISTORY_RECENT_LIMIT=60
HISTORY_SIMILARITY_THRESHOLD=0.72
HISTORY_BRANCH=shorts-state
# Actions supplies owner/repo and an ephemeral GITHUB_TOKEN; no PAT needed.
GITHUB_REPOSITORY=
GITHUB_TOKEN=