{
  "name": "reddit-video-generator",
  "version": "2.0.0",
  "description": "Headless automated video generation framework for scalable storytelling content with TTS caching, asset pools, and Hormozi captions.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "generate": "tsx src/index.ts",
    "generate:daily": "tsx src/autoPipeline.ts",
    "batch": "tsx src/index.ts --batch content/batch_config.json",
    "excel": "tsx src/index.ts --excel content/sample_stories.xlsx"
  },
  "keywords": [
    "reddit",
    "video-generator",
    "batch-processing",
    "tts",
    "ffmpeg",
    "captions",
    "tiktok",
    "youtube-shorts",
    "automation"
  ],
  "author": "Antigravity Engineer",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "axios": "^1.7.9",
    "canvas": "^3.2.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^176.0.0",
    "node-edge-tts": "^1.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
